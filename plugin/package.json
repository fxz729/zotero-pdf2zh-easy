{
    "name": "zotero-pdf2zh-easy",
    "version": "0.1.0",
    "description": "Guided local engine installation, quiet background translation and bilingual PDF progress cards for Zotero. Independent PDF2zh distribution.",
    "config": {
        "addonName": "PDF2zh Easy",
        "addonID": "pdf2zh-easy@fxz729",
        "addonRef": "pdf2zhEasy",
        "addonInstance": "pdf2zhEasy",
        "prefsPrefix": "extensions.zotero.pdf2zhEasy"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fxz729/zotero-pdf2zh-easy.git"
    },
    "author": "guaguastandup (upstream); fxz729 (Easy distribution)",
    "bugs": {
        "url": "https://github.com/fxz729/zotero-pdf2zh-easy/issues"
    },
    "homepage": "https://github.com/fxz729/zotero-pdf2zh-easy#readme",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "start": "zotero-plugin serve",
        "build": "node ../scripts/package-runtime.cjs && tsc --noEmit && zotero-plugin build && python -B ../scripts/audit_release.py --archive-only --xpi build/pdf-2-zh-easy.xpi",
        "lint:check": "prettier --check . && eslint .",
        "lint:fix": "prettier --write . && eslint . --fix",
        "release": "zotero-plugin release",
        "test": "node --experimental-strip-types --test tests/*.test.mts",
        "update-deps": "npm update --save"
    },
    "dependencies": {
        "zotero-plugin-toolkit": "^5.1.0-beta.10"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@napi-rs/canvas": "^0.1.80",
        "@types/node": "^22.13.10",
        "axios": "^1.8.2",
        "eslint": "^9.22.0",
        "form-data": "^4.0.2",
        "path": "^0.12.7",
        "prettier": "^3.5.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0",
        "zotero-plugin-scaffold": "0.9.3",
        "zotero-types": "^4.1.0-beta.4"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "endOfLine": "lf",
        "overrides": [
            {
                "files": [
                    "*.xhtml"
                ],
                "options": {
                    "htmlWhitespaceSensitivity": "css"
                }
            }
        ]
    }
}
